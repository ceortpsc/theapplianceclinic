{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "packages/database/src/*": ["../../packages/database/src/*"],
      "@clinic/common": ["../../packages/common/src/index.ts"],
      "@clinic/store-operations": ["../../packages/store-operations/src/index.ts"],
      "@clinic/store-operations/engine": ["../../packages/store-operations/src/engine.ts"]
    }
  },
  "include": ["src/**/*"]
}

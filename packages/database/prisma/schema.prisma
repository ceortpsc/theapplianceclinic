datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  ADMINISTRATOR
  OFFICE_MANAGER
  DISPATCHER
  TECHNICIAN
  WAREHOUSE
  PAYROLL
  HR
  ACCOUNTING
  CUSTOMER_SERVICE
  SALES
  MANAGER
  AUDITOR
  READ_ONLY
}

enum WorkOrderStatus {
  UNASSIGNED
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum InventoryCondition {
  RECEIVED
  INSPECTION_REQUIRED
  REFURBISHMENT
  QUALITY_REVIEW
  READY_FOR_SALE
  RESERVED
  SOLD
  RETURNED
  SCRAPPED
}

enum SalesOrderStatus {
  DRAFT
  OPEN
  AWAITING_INVENTORY
  AWAITING_PAYMENT
  READY_FOR_FULFILLMENT
  FULFILLMENT_IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  VOIDED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}

enum FulfillmentMode {
  CUSTOMER_PICKUP
  STORE_DELIVERY
  FIELD_SERVICE
  THIRD_PARTY_DELIVERY
}

enum FulfillmentStatus {
  OPEN
  AWAITING_INVENTORY
  AWAITING_CUSTOMER
  SCHEDULED
  ASSIGNED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  FAILED
  CANCELLED
  ON_HOLD
}

enum DeliveryManifestStatus {
  DRAFT
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum AiTaskStatus {
  DRAFT
  QUEUED
  IN_PROGRESS
  HUMAN_REVIEW
  APPROVED
  RELEASED
  ESCALATED
  CANCELLED
}

enum AiRiskTier {
  ROUTINE
  CONTROLLED
  HIGH
  MATERIAL
}

enum OperationalEventSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

model Store {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  timezone            String               @default("America/Chicago")
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  phone               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  registers           Register[]
  inventoryUnits      InventoryUnit[]
  sales               SalesOrder[]
  fulfillmentOrders   FulfillmentOrder[]
  deliveryManifests   DeliveryManifest[]
  aiTasks             AiTask[]
  operationalEvents   OperationalEvent[]
}

model User {
  id                  String             @id @default(uuid())
  storeId             String?
  store               Store?             @relation(fields: [storeId], references: [id])
  email               String             @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                 UserRole           @default(READ_ONLY)
  department           String?
  mfaSecret            String?
  isMfaEnabled         Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  auditLogs            AuditLog[]
  assignedOrders       WorkOrder[]        @relation("TechAssignments")
  timeCards            TimeCard[]
  payrolls             PayrollEntry[]
  createdSales         SalesOrder[]       @relation("SalesCreatedBy")
  approvedSales        SalesOrder[]       @relation("SalesApprovedBy")
  dispatchedManifests  DeliveryManifest[] @relation("ManifestDispatcher")
  assignedAiTasks      AiTask[]           @relation("AiTaskAssignee")
  reviewedAiTasks      AiTask[]           @relation("AiTaskReviewer")
  operationalEvents    OperationalEvent[] @relation("OperationalEventActor")

  @@index([storeId, role])
}

model Customer {
  id                String             @id @default(uuid())
  squareId          String?            @unique
  companyName       String?
  firstName         String
  lastName          String
  email             String             @unique
  phone             String
  smsConsent        Boolean            @default(false)
  emailConsent      Boolean            @default(false)
  preferredChannel  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  equipment         Equipment[]
  workOrders        WorkOrder[]
  invoices          Invoice[]
  sales             SalesOrder[]
  fulfillmentOrders FulfillmentOrder[]
}

model Equipment {
  id             String      @id @default(uuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  type           String
  brand          String
  modelNumber    String
  serialNumber   String      @unique
  warrantyExpiry DateTime?
  workOrders     WorkOrder[]
}

model WorkOrder {
  id             String          @id @default(uuid())
  status         WorkOrderStatus @default(UNASSIGNED)
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  equipmentId    String?
  equipment      Equipment?      @relation(fields: [equipmentId], references: [id])
  technicianId   String?
  technician     User?           @relation("TechAssignments", fields: [technicianId], references: [id])
  description    String
  scheduledDate  DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoices       Invoice[]
}

model Register {
  id           String       @id @default(uuid())
  storeId      String
  store        Store        @relation(fields: [storeId], references: [id])
  code         String
  name         String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sales        SalesOrder[]

  @@unique([storeId, code])
}

model InventoryUnit {
  id                 String             @id @default(uuid())
  storeId            String
  store              Store              @relation(fields: [storeId], references: [id])
  sku                String
  serialNumber       String             @unique
  category           String
  brand              String
  modelNumber        String
  condition          InventoryCondition @default(RECEIVED)
  acquisitionSource  String?
  acquisitionCost    Decimal            @db.Decimal(12, 2)
  listPrice          Decimal            @db.Decimal(12, 2)
  floorPrice         Decimal?           @db.Decimal(12, 2)
  warehouseLocation  String?
  reservedUntil      DateTime?
  receivedAt         DateTime            @default(now())
  inspectedAt        DateTime?
  readyAt            DateTime?
  soldAt             DateTime?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  saleLines          SaleLineItem[]

  @@index([storeId, condition])
  @@index([storeId, sku])
}

model SalesOrder {
  id                 String             @id @default(uuid())
  storeId            String
  store              Store              @relation(fields: [storeId], references: [id])
  registerId         String?
  register           Register?          @relation(fields: [registerId], references: [id])
  customerId         String?
  customer           Customer?          @relation(fields: [customerId], references: [id])
  createdById        String
  createdBy          User               @relation("SalesCreatedBy", fields: [createdById], references: [id])
  approvedById       String?
  approvedBy         User?              @relation("SalesApprovedBy", fields: [approvedById], references: [id])
  status             SalesOrderStatus   @default(DRAFT)
  subtotal           Decimal            @db.Decimal(12, 2) @default(0.00)
  discountAmount     Decimal            @db.Decimal(12, 2) @default(0.00)
  taxAmount          Decimal            @db.Decimal(12, 2) @default(0.00)
  totalAmount        Decimal            @db.Decimal(12, 2) @default(0.00)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  approvedAt         DateTime?
  completedAt        DateTime?
  lineItems          SaleLineItem[]
  payments           PaymentRecord[]
  fulfillment        FulfillmentOrder?

  @@index([storeId, status, createdAt])
  @@index([customerId, createdAt])
}

model SaleLineItem {
  id                 String          @id @default(uuid())
  saleId             String
  sale               SalesOrder      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventoryUnitId    String?
  inventoryUnit      InventoryUnit?  @relation(fields: [inventoryUnitId], references: [id])
  description        String
  quantity           Int             @default(1)
  unitPrice          Decimal         @db.Decimal(12, 2)
  discountAmount     Decimal         @db.Decimal(12, 2) @default(0.00)
  taxAmount          Decimal         @db.Decimal(12, 2) @default(0.00)
  lineTotal          Decimal         @db.Decimal(12, 2)

  @@index([saleId])
  @@index([inventoryUnitId])
}

model PaymentRecord {
  id                 String        @id @default(uuid())
  saleId             String
  sale               SalesOrder    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  provider           String
  providerReference  String?       @unique
  method             String
  status             PaymentStatus @default(PENDING)
  amount             Decimal       @db.Decimal(12, 2)
  receivedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([saleId, status])
}

model FulfillmentOrder {
  id                  String            @id @default(uuid())
  storeId             String
  store               Store             @relation(fields: [storeId], references: [id])
  saleId              String            @unique
  sale                SalesOrder        @relation(fields: [saleId], references: [id])
  customerId          String?
  customer            Customer?         @relation(fields: [customerId], references: [id])
  mode                FulfillmentMode
  status              FulfillmentStatus @default(OPEN)
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  windowStart         DateTime?
  windowEnd           DateTime?
  instructions        String?
  customerReadyAt     DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveryStop        DeliveryStop?

  @@index([storeId, status, windowStart])
}

model DeliveryManifest {
  id                  String                 @id @default(uuid())
  storeId             String
  store               Store                  @relation(fields: [storeId], references: [id])
  dispatcherId        String?
  dispatcher          User?                  @relation("ManifestDispatcher", fields: [dispatcherId], references: [id])
  routeDate           DateTime
  vehicleReference    String?
  crew                Json?
  status              DeliveryManifestStatus @default(DRAFT)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  stops               DeliveryStop[]

  @@index([storeId, routeDate, status])
}

model DeliveryStop {
  id                  String            @id @default(uuid())
  manifestId          String
  manifest            DeliveryManifest  @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  fulfillmentOrderId  String            @unique
  fulfillmentOrder    FulfillmentOrder  @relation(fields: [fulfillmentOrderId], references: [id])
  sequence            Int
  status              FulfillmentStatus @default(SCHEDULED)
  proofReference      String?
  recipientName       String?
  failureReason       String?
  arrivedAt           DateTime?
  completedAt         DateTime?

  @@unique([manifestId, sequence])
}

model Invoice {
  id              String             @id @default(uuid())
  squareInvoiceId String?            @unique
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  workOrderId     String
  workOrder       WorkOrder          @relation(fields: [workOrderId], references: [id])
  totalAmount     Decimal            @db.Decimal(12, 2)
  taxAmount       Decimal            @db.Decimal(12, 2)
  isPaid          Boolean            @default(false)
  createdAt       DateTime           @default(now())
  jeGroup         JournalEntryGroup?
}

model Account {
  id      String        @id @default(uuid())
  code    String        @unique
  name    String
  type    AccountType
  balance Decimal       @db.Decimal(14, 2) @default(0.00)
  lines   JournalLine[]
}

model JournalEntryGroup {
  id          String        @id @default(uuid())
  description String
  referenceId String?
  invoiceId   String?       @unique
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  postedAt    DateTime      @default(now())
  lines       JournalLine[]
}

model JournalLine {
  id        String            @id @default(uuid())
  groupId   String
  group     JournalEntryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  accountId String
  account   Account           @relation(fields: [accountId], references: [id])
  debit     Decimal           @db.Decimal(14, 2) @default(0.00)
  credit    Decimal           @db.Decimal(14, 2) @default(0.00)
}

model TimeCard {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  clockIn     DateTime
  clockOut    DateTime?
  totalHours  Float    @default(0.0)
  isProcessed Boolean  @default(false)
}

model PayrollEntry {
  id                       String   @id @default(uuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id])
  payPeriodStart           DateTime
  payPeriodEnd             DateTime
  grossPay                 Decimal  @db.Decimal(12, 2)
  netPay                   Decimal  @db.Decimal(12, 2)
  taxWithheld              Decimal  @db.Decimal(12, 2)
  isDirectDepositExecuted  Boolean  @default(false)
  createdAt                DateTime @default(now())
}

model AiTask {
  id                     String       @id @default(uuid())
  storeId                String
  store                  Store        @relation(fields: [storeId], references: [id])
  assigneeId             String?
  assignee               User?        @relation("AiTaskAssignee", fields: [assigneeId], references: [id])
  reviewerId             String?
  reviewer               User?        @relation("AiTaskReviewer", fields: [reviewerId], references: [id])
  capabilityId           String
  title                  String
  instruction            String
  status                 AiTaskStatus @default(DRAFT)
  riskTier               AiRiskTier   @default(CONTROLLED)
  sourceRefs             Json?
  output                 Json?
  prohibitedActionFlag   Boolean      @default(false)
  reviewDisposition      String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  completedAt            DateTime?

  @@index([storeId, status, riskTier])
}

model OperationalEvent {
  id             String                   @id @default(uuid())
  storeId        String
  store          Store                    @relation(fields: [storeId], references: [id])
  actorId        String?
  actor          User?                    @relation("OperationalEventActor", fields: [actorId], references: [id])
  eventType      String
  aggregateType  String
  aggregateId    String
  severity       OperationalEventSeverity @default(INFO)
  payload        Json?
  correlationId  String?
  occurredAt     DateTime                 @default(now())

  @@index([storeId, eventType, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([correlationId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  payload    Json?
  ipAddress  String
  userAgent  String
  timestamp  DateTime @default(now())
}

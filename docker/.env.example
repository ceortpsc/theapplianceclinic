# Environment variable template for Docker Compose
# Copy this file to .env and fill in the values. NEVER commit .env to source control.

# PostgreSQL
POSTGRES_USER=clinic_admin
POSTGRES_PASSWORD=
POSTGRES_DB=appliance_clinic_prod

# Application
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres-db:5432/${POSTGRES_DB}?schema=public
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# Web Client
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

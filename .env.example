# Root environment variable template.
# Copy to .env and fill in all values. NEVER commit .env to source control.

# Database
DATABASE_URL=${DB_PROTOCOL}://${DB_USER}:${DB_PASS}@localhost:5432/appliance_clinic_dev?schema=public

# API Gateway
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
PORT=4000

# Web Client
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
